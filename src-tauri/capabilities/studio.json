{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio",
  "description": "Native file dialogs and tray commands in the studio window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
